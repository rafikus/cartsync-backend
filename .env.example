# Copy to .env and fill in your values

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cartsync
DB_SSLMODE=disable

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Email (optional - if disabled, reset tokens will be logged to console)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@cartsync.app

# Server
PORT=3000
UPLOAD_DIR=./uploads
